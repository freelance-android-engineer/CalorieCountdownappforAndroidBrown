                <action android:name="ese.com.caloriecountdownappforandroidbrown.DEBIT_DAY_END" />
                <action android:name="ese.com.caloriecountdownappforandroidbrown.FOURPM_FOOD_NOTES" />
            </intent-filter>
        </receiver>


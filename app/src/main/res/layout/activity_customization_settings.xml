<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Section: Balance Text Color ──────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Countdown Balance Color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/palette_text_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp" />
        </HorizontalScrollView>

        <!-- ── Section: Font Style ──────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Font Style"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="6dp" />

        <RadioGroup
            android:id="@+id/rg_font_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_font_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Default"
                android:layout_marginEnd="8dp" />

            <RadioButton
                android:id="@+id/rb_font_bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bold"
                android:layout_marginEnd="8dp" />

            <RadioButton
                android:id="@+id/rb_font_serif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Serif"
                android:layout_marginEnd="8dp" />

            <RadioButton
                android:id="@+id/rb_font_mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mono" />
        </RadioGroup>

        <!-- ── Section: Number Format ───────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Number Format"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="6dp" />

        <RadioGroup
            android:id="@+id/rg_number_format"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_format_plain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plain  (70500)"
                android:layout_marginEnd="16dp" />

            <RadioButton
                android:id="@+id/rb_format_comma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Commas  (70,500)" />
        </RadioGroup>

        <!-- ── Section: Circle Style ────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Balance Circle Style"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="6dp" />

        <RadioGroup
            android:id="@+id/rg_circle_style"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_circle_none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="None" />

            <RadioButton
                android:id="@+id/rb_circle_thin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thin Border" />

            <RadioButton
                android:id="@+id/rb_circle_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medium Border" />

            <RadioButton
                android:id="@+id/rb_circle_thick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thick Border" />

            <RadioButton
                android:id="@+id/rb_circle_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transparent Glass Overlay" />
        </RadioGroup>

        <!-- ── Section: Credit Button Color ────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Credit Button Color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/palette_credit_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp" />
        </HorizontalScrollView>

        <!-- ── Section: Debit Button Color ─────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Debit Button Color"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="6dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/palette_debit_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp" />
        </HorizontalScrollView>

        <!-- ── Section: Background Image ───────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Background Image"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="20dp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:id="@+id/container_background_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ── Action Buttons ────────────────────────────────────────── -->
        <Button
            android:id="@+id/btn_apply_customization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Apply &amp; Close" />

        <Button
            android:id="@+id/btn_reset_customization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Reset to Defaults" />

    </LinearLayout>
</ScrollView>

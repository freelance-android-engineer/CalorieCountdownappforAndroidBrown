<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/new_activity_item_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingBottom="24dp" />

    <!-- Activity Name -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/new_activity_item_name_label"
        android:textSize="14sp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/et_activity_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/new_activity_item_name_hint"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:imeOptions="actionNext" />

    <!-- Standard Calories Burnt Per Minute -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/new_activity_cal_per_min_label"
        android:textSize="14sp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp" />

    <EditText
        android:id="@+id/et_activity_cal_per_min"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/new_activity_cal_per_min_hint"
        android:inputType="numberDecimal"
        android:maxLines="1"
        android:imeOptions="actionDone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/new_activity_cal_per_min_note"
        android:textSize="12sp"
        android:textColor="#888888"
        android:paddingTop="4dp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp">

        <Button
            android:id="@+id/btn_save_activity_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/new_activity_btn_save" />

        <Button
            android:id="@+id/btn_cancel_activity_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/btn_cancel" />

    </LinearLayout>

</LinearLayout>

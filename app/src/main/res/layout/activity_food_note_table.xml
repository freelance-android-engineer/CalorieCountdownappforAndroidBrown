<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Date Range Title with Edit Icon -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:layout_marginBottom="8dp"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvDateRangeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@+id/ivEditDate"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:text="Food Notes for Today"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:maxLines="2"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/ivEditDate"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Edit Date"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </RelativeLayout>

    <Button
        android:id="@+id/btnSelectAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select All"
        android:layout_marginBottom="4dp" />

    <HorizontalScrollView
        android:id="@+id/tableScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:scrollbars="horizontal">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TableLayout
                android:id="@+id/tableLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:divider="@android:drawable/divider_horizontal_bright"
                android:showDividers="middle"
                android:stretchColumns="2,3,4,5">

                <!-- Header Row -->
                <TableRow
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="Select"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="S. No."
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="Food/Drink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="@string/calories_guesstimate"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="Quantity"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="5dp"
                        android:text="Date &amp; Time"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </TableRow>
            </TableLayout>
        </ScrollView>
    </HorizontalScrollView>

    <!-- Memo Panel Section - Between Food Notes table and Buttons -->
    <LinearLayout
        android:id="@+id/memoPanelLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#F5F5F5"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/food_note_memo_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="4dp" />

        <!-- Memo Input Row: Text field on left, Image icon on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Memo Text Area (Left side) -->
            <EditText
                android:id="@+id/etMemoText"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:gravity="top|start"
                android:hint="Write your memo here..."
                android:inputType="textMultiLine"
                android:background="@android:drawable/edit_text"
                android:padding="8dp"
                android:minLines="3"
                android:scrollbars="vertical" />

            <!-- Image Icon Container (Right side) -->
            <FrameLayout
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="8dp">

                <!-- Image Icon Button (shows dialog with Camera/Gallery options) -->
                <ImageView
                    android:id="@+id/ivMemoAddImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:scaleType="center"
                    android:background="@android:drawable/edit_text"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Add Image"
                    android:padding="12dp" />

                <!-- Image Preview (shows when image is selected, replaces icon) -->
                <ImageView
                    android:id="@+id/ivMemoImagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Memo Image Preview" />

            </FrameLayout>

        </LinearLayout>

        <!-- Save, Clear, and AI Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnMemoSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnMemoClear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear"
                android:textSize="14sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnMemoAi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AI"
                android:textSize="14sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Buttons / Other content take remaining 2/3 of screen -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btnAddNewRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add New NOTE" />

            <Button
                android:id="@+id/btnAddRowWithImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Row with Image" />

            <Button
                android:id="@+id/btnEditRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EDIT FOOD NOTE" />

            <Button
                android:id="@+id/btnAddCertainty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Certainty" />

            <Button
                android:id="@+id/btnSumCalories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sum Calories" />

            <Button
                android:id="@+id/btnInputNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Input Food/Drink Note" />

            <Button
                android:id="@+id/btnTransferCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Transfer to Credit" />

            <Button
                android:id="@+id/btnFoodNoteAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ai" />

            <Button
                android:id="@+id/btnCreateAiPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Create AI Prompt" />

            <Button
                android:id="@+id/btnDeleteNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Delete Note(s)" />

            <Button
                android:id="@+id/btnSaveNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_save_notes" />

            <Button
                android:id="@+id/nearestAi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_nearest_ai" />

            <Button
                android:id="@+id/btnKitty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kitty" />

            <Button
                android:id="@+id/btn4PM"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4PM"
                android:textStyle="bold"
                android:backgroundTint="@color/colorPrimary"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnCheckBeforeYouEat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Check Before You Eat"
                android:textStyle="bold"
                android:backgroundTint="#FF6F00"
                android:textColor="@android:color/white" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>

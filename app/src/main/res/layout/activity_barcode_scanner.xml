<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Live camera preview fills the whole screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- White-bordered scan guide frame shown in the center -->
    <View
        android:id="@+id/scanFrame"
        android:layout_width="280dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:background="@drawable/barcode_scan_frame" />

    <!-- Hint text at the top -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="48dp"
        android:background="#88000000"
        android:gravity="center"
        android:padding="12dp"
        android:text="Point camera at food barcode"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Cancel button at the bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnCancelScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#CC333333"
            android:text="Cancel"
            android:textColor="@android:color/white" />

    </LinearLayout>

</FrameLayout>
